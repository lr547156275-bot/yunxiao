+                    out + '/tx_serialization.csv'}.items():
+            t = setkey(t, k, str(v))
+        t = delkey(t, 'CBAP_QC_TRACE_FILE')
+        put('configs/%s.txt' % tag, t)
+        print('cell %-22s single-flow line-rate check, stop=%.3fs'
