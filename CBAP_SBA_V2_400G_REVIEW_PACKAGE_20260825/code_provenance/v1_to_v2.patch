+        # 64-way sync burst, CC inert (KMIN >> buffer), bg 0.8C
+        tag = 'pf_burst_%dg' % rate
+        batch_s = FANIN * 262144 * 8.0 * (PKT_WIRE / PKT_PAY) / C
+        stop = 0.1 + batch_s * 5 + 0.03
+        make_cell(tag, 'dcqcn', rate, 262144, stop,
