+                'PMAX_MAP': '1 %d 0.2' % int(C),
+                'FINAL_COLLECTIVE_FLOW_COUNT': '1',
+                'PACKET_PAYLOAD_SIZE': '952',
+                'TX_TIME_ROUND_NS': '1',
