# Python caches
**/__pycache__/
*.py[cod]

# Native and ns-3 build products
*.o
*.so
*.pc
simulation/build/
simulation/.waf*/
simulation/.lock-waf*
simulation/tests/.build/

# Generated experiment outputs
*.csv
*.tsv
*.log
*.flag
*.gz
*.tar.gz
*.tar.gz.sha256
*.pdf
*.png
*.svg
**/runs/
**/runs_*/
**/processed/
**/recomputed/
**/figures/
**/codex_logs/
**/preflight/
**/preflight_*/
**/victim_calibration/
**/victim_cases/
**/tests/.build/

# Generated case material; canonical generators and configs stay tracked
**/cases/

# Local snapshots, audits, and archives
.cleanup_backup/
cleanup_audit/
research_archive/
codex_tasks/
simulation/research_archive/
simulation/codex_tasks/
cbap_clos_partial_audit/
cbap_v13_simple_statistics/
rwmcr_problem1.patch

# Simulator runtime leftovers
simulation/fct.txt

# Per-port queue histograms from QLEN_MON_FILE (tens of MB per run)
**/qlen.txt

# Final paper deliverables: the extracted results are small (about 900KB) and
# belong under version control so the numbers are reproducible and auditable.
# The 6.9GB of raw per-cell traces they were extracted from stay excluded --
# they are regenerable from the configs.
!simulation/experiment/scheme1_sba/final_report/**
!simulation/experiment/scheme1_sba/analysis_s*/**
!simulation/experiment/scheme1_sba/matrix_logs/**
!simulation/experiment/scheme1_sba/cell_configs/**
!simulation/experiment/scheme1_sba/final_report/charts/**

# raw simulation traces (GBs) -- regenerable deterministically from configs
simulation/experiment/scheme1_sba/*_out/
simulation/experiment/scheme1_sba/*.INVALID*/
simulation/experiment/scheme1_sba/*.NOTRACE/

# container-generated scratch output
nohup.out
